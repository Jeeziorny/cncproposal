{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNC Cutting Application - IPC Protocol",
  "description": "Communication protocol between Electron frontend and Python backend subprocess",
  
  "definitions": {
    "BaseRequest": {
      "type": "object",
      "required": ["id", "timestamp", "operation"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique request identifier for correlation"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Request timestamp in ISO 8601 format"
        },
        "operation": {
          "type": "string",
          "description": "Operation name to execute"
        },
        "params": {
          "type": "object",
          "description": "Operation-specific parameters"
        }
      }
    },
    
    "BaseResponse": {
      "type": "object",
      "required": ["correlated_request_id", "timestamp", "status"],
      "properties": {
        "correlated_request_id": {
          "type": "string",
          "description": "Request ID this response correlates to"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Response timestamp in ISO 8601 format"
        },
        "status": {
          "type": "string",
          "enum": ["success", "error"],
          "description": "Operation execution status"
        },
        "data": {
          "type": "object",
          "description": "Operation results (present on success)"
        },
        "error": {
          "$ref": "#/definitions/ErrorInfo",
          "description": "Error information (present on error)"
        }
      }
    },
    
    "ErrorInfo": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_DXF_FORMAT",
            "MULTIPLE_FIGURES",
            "OPEN_FIGURE", 
            "INTERSECTING_LINES",
            "OVERLAPPING_LINES",
            "REDUNDANT_POINTS",
            "FILE_NOT_FOUND",
            "FILE_READ_ERROR",
            "FILE_WRITE_ERROR",
            "INVALID_GCODE_FORMAT",
            "PROJECT_NOT_FOUND",
            "INVALID_CANVAS_STATE",
            "VALIDATION_FAILED",
            "OPERATION_FAILED",
            "INVALID_PARAMETERS",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "description": "Additional error context"
        }
      }
    },
    
    "CanvasState": {
      "type": "object",
      "required": ["geometries"],
      "properties": {
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "definitions.json#/definitions/Geometry"
          },
          "description": "Array of geometry objects in the canvas"
        },
        "cuttingPaths": {
          "type": "array",
          "items": {
            "$ref": "definitions.json#/definitions/CuttingPath"
          },
          "description": "Array of cutting path definitions"
        },
        "metadata": {
          "$ref": "definitions.json#/definitions/ProjectMetadata",
          "description": "Project metadata and settings"
        },
        "settings": {
          "type": "object",
          "properties": {
            "units": {
              "type": "string",
              "enum": ["mm", "cm", "m", "inch", "feet"]
            },
            "precision": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1.0
            },
            "toolDiameter": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    
    "ValidationResult": {
      "type": "object",
      "required": ["isValid"],
      "properties": {
        "isValid": {
          "type": "boolean",
          "description": "Whether the validation passed"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "definitions.json#/definitions/ValidationError"
          },
          "description": "Array of validation errors found"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "geometryId": { "type": "string" },
              "position": { "$ref": "definitions.json#/definitions/Point" }
            }
          },
          "description": "Array of validation warnings"
        }
      }
    }
  },
  
  "operations": {
    "import_dxf": {
      "description": "Import and parse DXF file",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "import_dxf" },
              "params": {
                "type": "object",
                "required": ["filePath"],
                "properties": {
                  "filePath": {
                    "type": "string",
                    "description": "Absolute path to the DXF file"
                  },
                  "encoding": {
                    "type": "string",
                    "default": "utf-8",
                    "description": "File encoding to use for reading"
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "importStats": {
                    "type": "object",
                    "properties": {
                      "geometryCount": { "type": "integer" },
                      "layerCount": { "type": "integer" },
                      "fileSize": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    
    "import_gcode": {
      "description": "Import existing G-code file",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "import_gcode" },
              "params": {
                "type": "object",
                "required": ["filePath"],
                "properties": {
                  "filePath": {
                    "type": "string",
                    "description": "Absolute path to the G-code file"
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "importStats": {
                    "type": "object",
                    "properties": {
                      "lineCount": { "type": "integer" },
                      "commandCount": { "type": "integer" },
                      "estimatedTime": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    
    "export_gcode": {
      "description": "Generate and export G-code file",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "export_gcode" },
              "params": {
                "type": "object",
                "required": ["canvasState", "filePath"],
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "filePath": {
                    "type": "string",
                    "description": "Output file path for G-code"
                  },
                  "machineSettings": {
                    "type": "object",
                    "properties": {
                      "feedRate": { "type": "number", "minimum": 0 },
                      "spindleSpeed": { "type": "number", "minimum": 0 },
                      "toolDiameter": { "type": "number", "minimum": 0 },
                      "safeHeight": { "type": "number" },
                      "cuttingDepth": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "filePath": { "type": "string" },
                  "exportStats": {
                    "type": "object",
                    "properties": {
                      "lineCount": { "type": "integer" },
                      "estimatedTime": { "type": "number" },
                      "totalLength": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    
    "validate": {
      "description": "Validate geometry and cutting paths",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "validate" },
              "params": {
                "type": "object",
                "required": ["canvasState"],
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "validationLevel": {
                    "type": "string",
                    "enum": ["basic", "strict", "production"],
                    "default": "basic"
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "validation": { "$ref": "#/definitions/ValidationResult" }
                }
              }
            }
          }
        ]
      }
    },
    
    "propose_rotation_points": {
      "description": "Suggest optimal blade rotation points",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "propose_rotation_points" },
              "params": {
                "type": "object",
                "required": ["canvasState"],
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "optimizationLevel": {
                    "type": "string",
                    "enum": ["fast", "balanced", "optimal"],
                    "default": "balanced"
                  },
                  "maxRotations": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 10
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "cuttingPaths": {
                    "type": "array",
                    "items": { "$ref": "definitions.json#/definitions/CuttingPath" }
                  },
                  "optimizationStats": {
                    "type": "object",
                    "properties": {
                      "rotationCount": { "type": "integer" },
                      "estimatedTime": { "type": "number" },
                      "efficiency": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    
    "save_project": {
      "description": "Save project to file",
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "save_project" },
              "params": {
                "type": "object",
                "required": ["projectName", "canvasState"],
                "properties": {
                  "projectName": {
                    "type": "string",
                    "description": "Project file name (without extension)"
                  },
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "filePath": {
                    "type": "string",
                    "description": "Optional custom save path"
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "filePath": { "type": "string" },
                  "fileSize": { "type": "integer" }
                }
              }
            }
          }
        ]
      }
    },
    
    "load_project": {
      "description": "Load project from file", 
      "request": {
        "allOf": [
          { "$ref": "#/definitions/BaseRequest" },
          {
            "properties": {
              "operation": { "const": "load_project" },
              "params": {
                "type": "object",
                "required": ["filePath"],
                "properties": {
                  "filePath": {
                    "type": "string",
                    "description": "Path to project file"
                  }
                }
              }
            }
          }
        ]
      },
      "response": {
        "allOf": [
          { "$ref": "#/definitions/BaseResponse" },
          {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "canvasState": { "$ref": "#/definitions/CanvasState" },
                  "projectInfo": {
                    "type": "object",
                    "properties": {
                      "version": { "type": "string" },
                      "lastModified": { "type": "string", "format": "date-time" },
                      "compatibilityVersion": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  
  "requestSchema": {
    "oneOf": [
      { "$ref": "#/operations/import_dxf/request" },
      { "$ref": "#/operations/import_gcode/request" },
      { "$ref": "#/operations/export_gcode/request" },
      { "$ref": "#/operations/validate/request" },
      { "$ref": "#/operations/propose_rotation_points/request" },
      { "$ref": "#/operations/save_project/request" },
      { "$ref": "#/operations/load_project/request" }
    ]
  },
  
  "responseSchema": {
    "oneOf": [
      { "$ref": "#/operations/import_dxf/response" },
      { "$ref": "#/operations/import_gcode/response" },
      { "$ref": "#/operations/export_gcode/response" },
      { "$ref": "#/operations/validate/response" },
      { "$ref": "#/operations/propose_rotation_points/response" },
      { "$ref": "#/operations/save_project/response" },
      { "$ref": "#/operations/load_project/response" }
    ]
  }
} 